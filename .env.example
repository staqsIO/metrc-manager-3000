# Created by scripts/setup.sh. Edit, then: docker compose up -d
# Keep every comment on its own line: trailing text on a value line is read as part of the value.

# Optional services to start with a bare `docker compose up` (comma list):
# mcp, ollama, cache, keyservice
COMPOSE_PROFILES=

# Docker Compose project name; it prefixes container and volume names. Do not change it on an
# existing install, or the stack starts on a new, empty database volume. Installs made before the
# rename to METRC Manager 3000 have no such line and keep the old name set in compose.yml.
COMPOSE_PROJECT_NAME=metrc-manager-3000
GITHUB_ORG=staqsIO

# ---- Required (setup.sh generates the secrets) ----
APP_URL=http://localhost:3000
# Host port for the web app (the container always listens on 3000)
PORT=3000
# Interface the web port binds to; set 127.0.0.1 when behind a reverse proxy on the same host
BIND_ADDRESS=0.0.0.0
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
# NEVER change after first use: stored facility keys depend on it
METRC_ENCRYPTION_KEY=
# NEVER change after first use
METRC_ENCRYPTION_SALT=
CRON_SECRET=
# Set to false to disable the METRC platform features (kill switch)
METRC_PLATFORM_ENABLED=true
# Set to 1 or true to enable Copilot agent runs
AGENT_RUNS_ENABLED=

# ---- Sign-in ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list; empty means no restriction
ALLOWED_EMAIL_DOMAINS=
# Public sign-up is off unless true
OPEN_SIGNUP=false
# Comma-separated token issuers allowed for portal auto-login; empty disables it
AUTO_LOGIN_ISSUER_WHITELIST=

# ---- METRC integrator (vendor) key: optional; facilities can store their own ----
# The MCP service reads the unsuffixed METRC_VENDOR_API_KEY / METRC_USER_API_KEY;
# the _CO variants are for platform seed scripts.
METRC_VENDOR_API_KEY=
METRC_VENDOR_API_KEY_CO=
METRC_USER_API_KEY=
METRC_USER_API_KEY_CO=

# ---- AI Copilot bootstrap: used once on first start; then manage providers in Super Admin > LLM Providers ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# http://ollama:11434 with the ollama profile
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:14b
# openrouter | ollama
LLM_DEFAULT_PROVIDER=

# ---- Optional services (set automatically by setup.sh for chosen profiles) ----
# http://metrc-mcp:8080 with the mcp profile
METRC_MCP_URL=
METRC_MCP_API_KEY=
METRC_API_URL=https://sandbox-api-co.metrc.com
# Browser origins allowed by the mcp service (comma separated); empty = same-origin only
MCP_ALLOWED_ORIGINS=
# Optional: key service endpoint and bearer token for the mcp /chat demo (the mcp service also gets OPENROUTER_API_KEY and OPENROUTER_MODEL)
OPENROUTER_KEY_URL=
OPENROUTER_KEY_TOKEN=
# Optional integrations
METRC_DOCS_MCP_URL=
METRC_DOCS_MCP_API_KEY=
MULTIAGENT_API_URL=
MULTIAGENT_API_KEY=
# redis://redis:6379 with the cache profile
REDIS_URL=
# http://keyservice:3001 with the keyservice profile
KEY_SERVICE_URL=
KEY_SERVICE_API_KEY=
# Never change after storing keys
KEYSERVICE_ENCRYPTION_KEY=
# Browser origins allowed by the key service (comma separated); empty = none
KEYSERVICE_ALLOWED_ORIGINS=

# ---- Email (domain verification) ----
RESEND_API_KEY=

# ---- Branding ----
# BRAND_NAME and BRAND_LOGO_URL are build-time: after changing them run `docker compose up -d --build`
# Empty means METRC Manager 3000
BRAND_NAME=
BRAND_LOGO_URL=
SUPPORT_EMAIL=
EMAIL_FROM=
# Optional; defaults to APP_URL/brand/logo.png
EMAIL_LOGO_URL=

# ---- Sync schedule (cron syntax; empty disables a job) ----
CRON_SYNC_DAILY=0 7 * * *
CRON_SYNC_FULL=0 8 1 * *
CRON_SYNC_SALES=0 * * * *

# ---- Optional: first admin for `pnpm create-admin` (flags take precedence) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_ORG=
